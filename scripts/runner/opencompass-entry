#!/usr/bin/env bash
# MoTTEavl 外部基准 Runner 入口（固定环境 wrapper，review R01/R2-01/R2-10）。
#
# 契约（与 motte_benchmark.process.ProcessJobAdapter 对齐）：
#   - 环境变量 MOTTE_WORK_DIR  : 受控工作目录（prepare 阶段创建）。
#   - 环境变量 MOTTE_LAUNCH_TOKEN / MOTTE_JOB_ID / MOTTE_RUN_ID : 启动身份。
#     wrapper 把 token 注入桥接层的 argv 并 exec——token 保留在最终进程
#     参数里，跨实例身份核验（argv 匹配）在 Worker 重启后仍可认领活进程
#     （review R3-03）；桥接层消费身份，绝不作为参数透传给上游 CLI。
#   - $MOTTE_WORK_DIR/runner-config.json : 冻结的平台配置（模型快照/逐题
#     数据（含结构化题目与 few-shot 示例）/凭据引用/config_hash）。
#   - 桥接（motte_benchmark.opencompass.entry）负责：按学科导出本地数据、
#     渲染 0.4.2 形态的 Python 配置、以位置参数调用 opencompass、定位
#     时间戳实验目录并写 outputs/experiment.json 指针（R2-02）、原子写
#     .motte-job-complete 完成标记（R2-10）。
#
# 固定环境（部署到 /opt/motte-runner，见 docs/operations/ceval.md）：
#   - pinned 解释器同时安装 opencompass==0.4.2 与 motte-benchmark-runtime；
#   - 凭据由 Runner 环境按引用注入（os.environ），命令行/配置不落明文。
set -euo pipefail

WORK_DIR="${MOTTE_WORK_DIR:?MOTTE_WORK_DIR is required}"

RUNNER_ROOT="${MOTTE_RUNNER_ROOT:-/opt/motte-runner}"
PYTHON_BIN="${MOTTE_RUNNER_PYTHON:-$RUNNER_ROOT/bin/python}"
if [ ! -x "$PYTHON_BIN" ]; then
    echo "pinned runner environment missing: $PYTHON_BIN" >&2
    MARKER="$WORK_DIR/.motte-job-complete"
    printf '{"exit_code": 4, "completed": true}\n' > "$MARKER.partial"
    mv "$MARKER.partial" "$MARKER"
    exit 4
fi

exec "$PYTHON_BIN" -m motte_benchmark.opencompass.entry \
    --launch-token "${MOTTE_LAUNCH_TOKEN:-}" \
    --job-id "${MOTTE_JOB_ID:-}" \
    --run-id "${MOTTE_RUN_ID:-}"
