.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.eggs/
*.egg-info/
.ruff_cache/
node_modules/
dist/
var/artifacts/*
var/*.db
var/*.db-*
!.gitkeep
.env

# ZCode 本地会话目录
.zcode/

# 本地 Git worktree
/.worktrees/
/.worktree/

# 测试集受控下载目录（官方数据集源文件）
var/datasets/

# M5/M6 手工验收与差异核对产物（脚本、证据、临时数据库）
var/m5-accept/
var/m6-accept/
var/m5-verify/

# Scenario 运行时 fixture（由服务生成，不是源码测试 fixture）
var/scenario-fixtures/

# 外部 Job 运行时状态（job-profile / runner-config / 完成标记）
var/external-jobs/

# runtime 执行侧状态（workspace / session 记录 / 产物）
var/pi-workspaces/
var/runtime-sessions/

# 脑暴视觉伴侣会话产物
.superpowers/

# Mimosa 扫描会话状态（不入库）
.mimosa/
