# 消费状态（2026-09-15）：
#   已读取：MOTTE_STORAGE、MOTTE_DB_PATH、MOTTE_PG_DSN/DATABASE_URL、ARTIFACT_ROOT、
#           OPENAI_API_KEY（live-smoke）
#   预留（暂无代码消费）：REDIS_URL（celery 实测待接）、OTEL_EXPORTER_OTLP_ENDPOINT、
#                         ANTHROPIC_API_KEY

# 已读取：存储后端选择，sqlite（默认，本地开发）或 postgres（生产）
MOTTE_STORAGE=sqlite

# 已读取：PostgreSQL DSN（MOTTE_STORAGE=postgres 时必填；兼容 postgresql+asyncpg 前缀）
MOTTE_PG_DSN=postgresql://motteavl:motteavl@localhost:5432/motteavl
DATABASE_URL=postgresql+asyncpg://motteavl:motteavl@localhost:5432/motteavl

# 已读取：sqlite 后端的数据库路径
MOTTE_DB_PATH=./var/runs.db

# 预留：Celery broker（阶段 1 worker 接入）
REDIS_URL=redis://localhost:6379/0

# 已读取：ArtifactStore 根目录
ARTIFACT_ROOT=./var/artifacts

# 预留：OTel exporter（当前仅 NoopTracer）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# 预留：仅由操作者显式 live-smoke 使用（阶段 2 接入），永不写入日志/Trace/Artifact
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
